<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>RuriLib</RootNamespace>
    <AssemblyName>RuriLib</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Legacy WPF-port code: docs comments, obsolete APIs and legacy crypto are intentional -->
    <NoWarn>$(NoWarn);CS1591;CS1573;CS0612;CS0618;CS0105;CA1416;SYSLIB0021;SYSLIB0039;SYSLIB0006</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.5.0" />
    <PackageReference Include="CaptchaSharp" Version="1.0.13" />
    <PackageReference Include="CaptchaSharp.Services.More" Version="1.0.0" />
    <PackageReference Include="IronPython" Version="3.4.1" />
    <PackageReference Include="Jint" Version="3.1.0" />
    <PackageReference Include="LiteDB" Version="5.0.19" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Selenium.WebDriver" Version="4.27.0" />
    <PackageReference Include="Selenium.Support" Version="4.27.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="..\Extreme.Net.dll" />
    <Reference Include="..\CloudflareSolverRe.dll" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PluginFramework\PluginFramework.csproj" />
  </ItemGroup>
</Project>
