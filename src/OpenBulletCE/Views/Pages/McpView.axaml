<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenBulletCE.ViewModels.Pages"
             xmlns:ob="clr-namespace:OpenBulletCE" mc:Ignorable="d"
             x:Class="OpenBulletCE.Views.Pages.McpView"
             x:DataType="vm:McpPageViewModel">

    <Design.DataContext>
        <vm:McpPageViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Spacing="10" MaxWidth="760">

            <!-- Status card -->
            <TextBlock Text="MCP SERVER" Classes="SectionHeader" />
            <Border Classes="Card" Padding="12,8">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Status:" FontWeight="Bold" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatusText}" Margin="8,0"
                               Foreground="{Binding StatusBrush}" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Endpoint:" FontWeight="Bold" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EndpointUrl}" Margin="8,0"
                               Foreground="{StaticResource BrushAccent}" />
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="Accent" Command="{Binding ReloadServerCommand}" Padding="14,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="M17.65,6.35A8,8 0 1,0 19.73,14H17.65A6,6 0 1,1 12,6V9L16,5.5 12,2V5.34A8,8 0 0,0 17.65,6.35Z" Width="12" Height="12" />
                        <TextBlock Text="Reload" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="Success" Command="{Binding StartServerCommand}" IsEnabled="{Binding CanStart}" Padding="14,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="M8,5.14V19.14L19,12.14L8,5.14Z" Width="12" Height="12" />
                        <TextBlock Text="Start" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="Danger" Command="{Binding StopServerCommand}" IsEnabled="{Binding CanStop}" Padding="14,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="M6,6H18V18H6V6Z" Width="12" Height="12" />
                        <TextBlock Text="Stop" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Separator Margin="0,4" />

            <!-- Configuration -->
            <TextBlock Text="CONFIGURATION" Classes="SectionHeader" />
            <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto">
                <CheckBox Grid.Row="0" Grid.Column="1" Content="Enabled (start MCP server on app launch)"
                          IsChecked="{Binding Settings.Enabled}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Port" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" Width="110" HorizontalAlignment="Left"
                               Value="{Binding Settings.Port, UpdateSourceTrigger=LostFocus, Converter={x:Static ob:IntDecimalConverter.Instance}}"
                               Minimum="1024" Maximum="65535" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Bind Address" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.BindAddress}"
                         Watermark="127.0.0.1 local only / 0.0.0.0 remote" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="API Key" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.ApiKey}"
                         Watermark="empty = no auth" />
            </Grid>
            <TextBlock Text="After changing port or bind address click Reload. Endpoint is http://{bind}:{port}/mcp"
                       Classes="Secondary" FontSize="11" />

            <Separator Margin="0,4" />

            <!-- Agent setup -->
            <TextBlock Text="AGENT SETUP" Classes="SectionHeader" />
            <TextBlock Text="One-click install: writes the OpenBullet CE MCP entry into each agent's config file."
                       Classes="Secondary" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="Accent" Command="{Binding InstallSelectedCommand}" Padding="14,6">
                    <TextBlock Text="Install Selected" />
                </Button>
                <Button Command="{Binding SelectAllCommand}" Padding="12,6" Content="Select All" />
                <Button Command="{Binding SelectNoneCommand}" Padding="12,6" Content="Select None" />
                <Button Command="{Binding RefreshAgentsCommand}" Padding="12,6" Content="Refresh" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Agents}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AgentInstallItem">
                        <Border Classes="Card" Padding="10,8" Margin="0,0,0,6">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                          VerticalAlignment="Center" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <Border Background="{StaticResource BrushSuccessMuted}" CornerRadius="3"
                                                Padding="6,1" IsVisible="{Binding IsInstalled}">
                                            <TextBlock Text="INSTALLED" FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource BrushSuccess}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Classes="Secondary" FontSize="11" />
                                    <TextBlock Text="{Binding ConfigPath}" Classes="Secondary" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="Accent" Padding="10,4" Margin="8,0,0,0"
                                        IsVisible="{Binding !IsInstalled}"
                                        Command="{Binding $parent[UserControl].DataContext.InstallAgentCommand}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="Install" />
                                </Button>
                                <Button Grid.Column="3" Classes="Danger" Padding="10,4" Margin="8,0,0,0"
                                        IsVisible="{Binding IsInstalled}"
                                        Command="{Binding $parent[UserControl].DataContext.UninstallAgentCommand}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="Remove" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Separator Margin="0,4" />

            <Button Classes="Accent" Command="{Binding SaveSettingsCommand}" Width="120"
                    HorizontalAlignment="Left" Padding="14,6">
                <TextBlock Text="Save" />
            </Button>

        </StackPanel>
    </ScrollViewer>
</UserControl>
