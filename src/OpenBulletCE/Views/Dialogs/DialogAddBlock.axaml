<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="OpenBulletCE.Views.Dialogs.DialogAddBlock"
        Title="Add Block" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BrushBackground}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tab selector -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="0,0,0,12">
            <Button x:Name="DefaultTab" Content="Default" Click="DefaultTab_Click" />
            <Button x:Name="PluginsTab" Content="Plugins" Click="PluginsTab_Click" />
        </StackPanel>

        <!-- Default blocks -->
        <ScrollViewer Grid.Row="1" x:Name="DefaultPanel" MaxHeight="400">
            <UniformGrid x:Name="DefaultButtonsGrid" Columns="3" />
        </ScrollViewer>

        <!-- Plugin blocks -->
        <ScrollViewer Grid.Row="1" x:Name="PluginsPanel" IsVisible="False" MaxHeight="400">
            <UniformGrid x:Name="PluginButtonsGrid" Columns="3" />
        </ScrollViewer>
    </Grid>
</Window>
