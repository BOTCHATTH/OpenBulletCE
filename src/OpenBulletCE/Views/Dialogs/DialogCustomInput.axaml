<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="OpenBulletCE.Views.Dialogs.DialogCustomInput"
        Title="Custom Input" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BrushBackground}">

    <StackPanel Margin="16" Spacing="12">
        <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Classes="Secondary" />

        <ItemsControl x:Name="InputsPanel">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding VariableName}" Classes="Secondary" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Value}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="Accent" Content="OK" MinWidth="80" Click="Accept_Click" />
            <Button Content="Cancel" MinWidth="80" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
